start_year:              2025
start_month:             11
start_day:               20
start_hour:              0
start_minute:            0
start_second:            0
nhours_fcst:             @[FHMAX]
fhrot:                   0

dt_atmos:                @[DT_ATMOS]
restart_interval:        6 -1
restart_fh:

quilting:                @[QUILTING]
quilting_restart:        .false.
write_groups:            @[WRITE_GROUP]
write_tasks_per_group:   @[WRTTASK_PER_GROUP]
itasks:                  1
output_history:          .true.
history_file_on_native_grid: .true.
num_files:               2
fv3atm_output_dir:       ./
filename_base:           'atm' 'sfc'
output_file:             'netcdf'

output_fh:               3 -1

output_grid:  @[OUTPUT_GRID]
